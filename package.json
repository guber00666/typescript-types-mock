{
  "name": "typescript-types-mock",
  "version": "1.0.6",
  "description": "Generate mock objects from TypeScript types for Playwright tests. Rust-powered, 10-50x faster than ts-morph.",
  "type": "module",
  "main": "./index.cjs",
  "types": "./index.d.ts",
  "napi": {
    "name": "typescript-types-mock",
    "triples": {
      "defaults": true,
      "additional": [
        "x86_64-unknown-linux-musl",
        "aarch64-unknown-linux-gnu",
        "aarch64-apple-darwin",
        "armv7-unknown-linux-gnueabihf"
      ]
    }
  },
  "ava": {
    "files": [
      "**/*.test.cjs"
    ],
    "extensions": {
      "cjs": true
    }
  },
  "exports": {
    ".": {
      "import": "./index.cjs",
      "require": "./index.cjs",
      "types": "./index.d.ts"
    },
    "./helpers": {
      "import": "./helpers.cjs",
      "require": "./helpers.cjs",
      "types": "./helpers.d.ts"
    },
    "./context": {
      "import": "./context.cjs",
      "require": "./context.cjs",
      "types": "./context.d.ts"
    }
  },
  "files": [
    "index.cjs",
    "index.d.ts",
    "helpers.cjs",
    "helpers.d.ts",
    "context.cjs",
    "context.d.ts",
    "*.node"
  ],
  "scripts": {
    "artifacts": "napi create-npm-dir -t . && napi artifacts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi prepublish -t npm",
    "universal": "napi universal",
    "version": "napi version",
    "test": "ava",
    "test:legacy": "vitest run",
    "test:legacy:watch": "vitest",
    "test:legacy:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "keywords": [
    "typescript",
    "mock",
    "playwright",
    "testing",
    "e2e",
    "codegen",
    "rust",
    "napi",
    "test-data",
    "fixtures",
    "route-interception",
    "performance"
  ],
  "author": "fess00666",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guber00666/typescript-types-mock.git"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0",
    "ava": "^6.0.0",
    "@microsoft/api-extractor": "^7.59.0",
    "@rslib/core": "^0.23.2",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^3.0.0",
    "oxlint": "^0.16.0",
    "ts-morph": "^25.0.0",
    "typescript": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">= 18"
  },
  "optionalDependencies": {
    "typescript-types-mock-win32-x64-msvc": "1.0.2",
    "typescript-types-mock-darwin-x64": "1.0.2",
    "typescript-types-mock-linux-x64-gnu": "1.0.2",
    "typescript-types-mock-linux-x64-musl": "1.0.2",
    "typescript-types-mock-linux-arm64-gnu": "1.0.2",
    "typescript-types-mock-darwin-arm64": "1.0.2",
    "typescript-types-mock-linux-arm-gnueabihf": "1.0.2"
  }
}
